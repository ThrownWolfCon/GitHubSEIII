`systemctl show ssh.service -p Wants -p Requires -p After -p Before`

```
thrownwolf@thrownwolf-5570:~$ systemctl show ssh.service -p Wants -p Requires -p After -p Before

Requires=sysinit.target -.mount ssh.socket system.slice
Wants=sshd-keygen.service
Before=shutdown.target
After=network.target cloud-init-network.service ssh.socket nss-user-lookup.target system.slice -.mount auditd.service sysinit.target systemd-journald.socket sshd-keygen.service basic.target

```
cat shows the actual unit file.

`systemctl cat ssh.service`

```ini
# /usr/lib/systemd/system/ssh.service
[Unit]
Description=OpenBSD Secure Shell server
Documentation=man:sshd(8) man:sshd_config(5)
After=network.target nss-user-lookup.target auditd.service
ConditionPathExists=!/etc/ssh/sshd_not_to_be_run

[Service]
EnvironmentFile=-/etc/default/ssh
ExecStartPre=/usr/sbin/sshd -t
ExecStart=/usr/sbin/sshd -D $SSHD_OPTS
ExecReload=/usr/sbin/sshd -t
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartPreventExitStatus=255
Type=notify
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
Alias=sshd.service
```

