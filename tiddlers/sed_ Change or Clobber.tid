[[Open This|sed: Change or Clobber]]

---

```bash
#this will replace the string PART in question.
# Like "=TRUE" to "=FALSE"
# bar foo foo foo foo
# IMPORTANT_VARIABLE=FALSE
# IMPORTANT_VARIABLE=FALSEFOR REALSIES!

sed -i '/IMPORTANT_VARIABLE=/s/=TRUE/=FALSE/' file.txt

##########################

#this will CLOBBER the string line:
# bar foo foo foo foo
# IMPORTANT_VARIABLE=FALSE
# IMPORTANT_VARIABLE=FALSE


sed -i '/IMPORTANT_VARIABLE=/c\IMPORTANT_VARIABLE=FALSE' file.txt
```

